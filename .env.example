# ==============================================================================
# ChatWithPDF - Environment Variables Configuration
# Copy this file to .env.local and populate the values below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Settings (Client & Server)
# Obtain these from your Supabase Project Dashboard -> Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_https://nwodkiafcycmsnhgwxsq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XzO3cSKtXGWuM9wKR84YVg_Nx0NaUPk

# ------------------------------------------------------------------------------
# 2. Supabase Server Secret Key (Optional / Admin tasks)
# Keep this secret. NEVER expose this in the client or commit to version control.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. AI Service Provider Key
# Provide an OpenAI API key (or Google Gemini key) for PDF question-answering.
# If left empty, the application will operate with graceful mock/diagnostic mode.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
# Optional OpenAI model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional Google Gemini API Key (if using Gemini provider)
# GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 4. Application URL (used for Auth redirects)
# In development: http://localhost:3000
# In production: https://your-domain.vercel.app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://nwodkiafcycmsnhgwxsq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XzO3cSKtXGxMuM9wKR84YVg_Nx8NaLPX
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...